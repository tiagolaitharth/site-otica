---
import { Image } from 'astro:assets';
import classico from '../assets/estilos/classico.png';
import moderno from '../assets/estilos/moderno.png';
import aviador from '../assets/estilos/aviador.png';
import minimal from '../assets/estilos/minimal.png';

const estilos = [
  {
    palavra: 'Clássico',
    imagem: classico,
    foco: '56%',
    alt: 'Homem de cabelos grisalhos ajustando óculos de acetato tartaruga em uma biblioteca',
  },
  {
    palavra: 'Moderno',
    imagem: moderno,
    foco: '48%',
    alt: 'Mulher de óculos quadrados em acetato mel, de blazer claro, diante de uma parede de concreto',
  },
  {
    palavra: 'Aviador',
    imagem: aviador,
    foco: '58%',
    alt: 'Homem de óculos aviador dourado à beira de uma estrada litorânea ao pôr do sol',
  },
  {
    palavra: 'Minimal',
    imagem: minimal,
    foco: '50%',
    alt: 'Mulher de gola alta usando óculos sem aro, em fundo claro',
  },
];

const dispersao = [
  { x: -45, y: -30, giro: -120 },
  { x: 60, y: 40, giro: 90 },
  { x: -30, y: 50, giro: 180 },
  { x: 50, y: -45, giro: -60 },
  { x: -55, y: 20, giro: 150 },
  { x: 35, y: -55, giro: -100 },
  { x: -20, y: -40, giro: 45 },
  { x: 45, y: 35, giro: -150 },
];

const letrasDe = (palavra: string) =>
  [...palavra.toUpperCase()].map((letra, indice) => ({
    letra,
    indice,
    ...dispersao[indice % dispersao.length],
  }));
---

<section class="estilos" id="colecao" aria-labelledby="estilos-titulo">
  <h2 class="sr-only" id="estilos-titulo">Estilos de óculos</h2>

  {
    estilos.map((estilo) => (
      <article class="painel" style={`--foco: ${estilo.foco}`}>
        <div class="painel-arte">
          <Image
            class="painel-foto"
            src={estilo.imagem}
            alt={estilo.alt}
            widths={[640, 1024, 1672]}
            sizes="100vw"
            quality={70}
          />
          <div class="painel-veu"></div>
        </div>

        <h3 class="painel-palavra">
          <span class="sr-only">{estilo.palavra}</span>
          <span aria-hidden="true">
            {letrasDe(estilo.palavra).map((l) => (
              <span
                class="letra"
                style={`--i: ${l.indice}; --dx: ${l.x}vw; --dy: ${l.y}vh; --giro: ${l.giro}deg`}
              >
                {l.letra}
              </span>
            ))}
          </span>
        </h3>
      </article>
    ))
  }
</section>

<style>
  .estilos {
    position: relative;
  }

  .painel {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    view-timeline: --painel block;
  }

  .painel-arte {
    position: absolute;
    inset: 0;
    background: var(--cor-marinho);
    transform-origin: bottom left;
  }

  .painel-arte :global(.painel-foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco) center;
    transform: scale(1.05);
  }

  .painel-veu {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(11 31 58 / 0.15), rgb(11 31 58 / 0.5));
  }

  .painel-palavra {
    position: relative;
    margin: 0;
    padding: 0 var(--margem-lateral);
    color: var(--cor-creme);
    mix-blend-mode: difference;
    font-family: var(--fonte-titulo);
    font-size: clamp(3.25rem, 19vw, 11rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
  }

  .letra {
    display: inline-block;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .painel + .painel .painel-arte {
        animation: abrir linear both;
        animation-timeline: --painel;
        animation-range: entry 0% entry 80%;
      }

      .letra {
        animation: reunir linear both;
        animation-timeline: --painel;
        animation-range: entry calc(var(--i) * 4%) entry calc(60% + var(--i) * 3%);
      }
    }
  }

  @keyframes abrir {
    from {
      transform: rotate(30deg);
    }
  }

  @keyframes reunir {
    from {
      opacity: 0.15;
      transform: translate(var(--dx), var(--dy)) rotate(var(--giro));
    }
  }
</style>
