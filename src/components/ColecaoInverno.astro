---
import { Image } from 'astro:assets';
import foto from '../assets/inverno.png';

const letras = [...'Inverno'];
const detalhes = ['Edição limitada', 'Prova com hora marcada', 'Acesso antes da abertura'];
---

<section class="inverno" id="inverno" aria-labelledby="inverno-titulo">
  <div class="container inverno-grade">
    <div class="inverno-texto">
      <p class="inverno-rotulo">Em breve · maio de 2027</p>

      <h2 class="inverno-titulo" id="inverno-titulo">
        <span class="inverno-colecao">Coleção</span>
        <span class="sr-only">Inverno 2027</span>
        <span class="inverno-nome" aria-hidden="true">
          <span class="inverno-palavra">
            {
              letras.map((letra, indice) => (
                <span class="inverno-letra" style={`--i: ${indice}`}>
                  {letra}
                </span>
              ))
            }
          </span>{' '}
          <em class="inverno-ano">2027</em>
        </span>
      </h2>

      <p class="inverno-abertura">
        Armações em <em>acetato fosco</em> nos tons grafite, vinho e tartaruga escura, com{' '}
        <em>lentes que escurecem</em> ao sair do ambiente fechado.
      </p>

      <ul class="inverno-detalhes">
        {detalhes.map((detalhe) => <li>{detalhe}</li>)}
      </ul>

      <form class="inverno-form" novalidate>
        <label class="campo">
          <span>Nome</span>
          <input type="text" name="nome" autocomplete="name" required />
        </label>
        <label class="campo">
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="campo">
          <span>Telefone (opcional)</span>
          <input type="tel" name="telefone" autocomplete="tel" placeholder="(00) 00000-0000" />
        </label>

        <button class="botao botao-dourado" type="submit">
          Quero acesso antecipado
          <span class="botao-seta" aria-hidden="true">→</span>
        </button>

        <p class="inverno-aviso">
          Um único aviso quando a coleção chegar. Site de demonstração: nenhum dado é enviado.
        </p>
      </form>

      <div class="inverno-confirmacao" hidden>
        <p class="inverno-confirmacao-titulo">Pronto, você está na lista.</p>
        <p class="inverno-nota">
          Em um site real, avisaríamos por e-mail assim que a coleção chegasse. Nesta
          demonstração, nenhum dado foi enviado.
        </p>
      </div>
    </div>

    <div class="inverno-moldura">
      <div class="inverno-foto">
        <Image
          src={foto}
          alt="Homem de óculos de armação preta redonda e cachecol marrom, em uma rua nevada"
          widths={[640, 1024, 1672]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          quality={72}
        />
      </div>
    </div>
  </div>
</section>

<script>
  const formulario = document.querySelector<HTMLFormElement>('.inverno-form');
  const confirmacao = document.querySelector<HTMLElement>('.inverno-confirmacao');

  if (formulario && confirmacao) {
    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault();
      formulario.hidden = true;
      confirmacao.hidden = false;
    });
  }
</script>

<style>
  .inverno {
    padding-block: 4rem;
    background: var(--cor-marinho);
    color: var(--cor-creme);
  }

  .inverno-grade {
    display: grid;
    gap: 3rem;
  }

  .inverno-moldura {
    position: relative;
    order: -1;
  }

  .inverno-moldura::before {
    content: '';
    position: absolute;
    inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--cor-dourado) 70%, transparent);
    border-radius: 1.25rem;
  }

  .inverno-foto {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 1.25rem;
    overflow: hidden;
  }

  .inverno-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  .inverno-rotulo {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    color: var(--cor-dourado);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .inverno-rotulo::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--cor-dourado);
  }

  .inverno-titulo {
    margin-bottom: 2rem;
    font-weight: 400;
    letter-spacing: normal;
    view-timeline: --titulo block;
  }

  .inverno-titulo::after {
    content: '';
    display: block;
    width: 5rem;
    height: 1px;
    margin-top: 1.75rem;
    background: var(--cor-dourado);
    transform-origin: left;
  }

  .inverno-colecao {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .inverno-nome {
    display: block;
    font-family: var(--fonte-titulo);
    font-size: clamp(3.5rem, 15vw, 7rem);
    letter-spacing: -0.02em;
    line-height: 0.95;
  }

  .inverno-letra {
    display: inline-block;
  }

  .inverno-ano {
    display: inline-block;
    padding-right: 0.08em;
    background: linear-gradient(
        100deg,
        var(--cor-dourado) 38%,
        color-mix(in srgb, var(--cor-dourado) 35%, var(--cor-creme)) 50%,
        var(--cor-dourado) 62%
      )
      0 0 / 260% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }

  .inverno-abertura {
    max-width: 30rem;
    margin-bottom: 2rem;
    color: color-mix(in srgb, var(--cor-creme) 92%, transparent);
    font-family: var(--fonte-titulo);
    font-size: clamp(1.5rem, 5.4vw, 1.875rem);
    line-height: 1.25;
  }

  .inverno-abertura em {
    color: var(--cor-dourado);
  }

  .inverno-detalhes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 2rem;
    max-width: 30rem;
    margin: 0 0 2.5rem;
    padding: 1.25rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--cor-creme) 22%, transparent);
    list-style: none;
  }

  .inverno-detalhes li {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .inverno-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 30rem;
  }

  .inverno-form[hidden],
  .inverno-confirmacao[hidden] {
    display: none;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .campo span {
    color: color-mix(in srgb, var(--cor-creme) 72%, transparent);
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-style: italic;
  }

  .campo input {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cor-creme) 35%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--cor-creme);
    font: inherit;
    font-size: 1.0625rem;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .campo input::placeholder {
    color: color-mix(in srgb, var(--cor-creme) 40%, transparent);
  }

  .campo input:focus {
    outline: none;
    border-bottom-color: var(--cor-dourado);
    box-shadow: 0 1px 0 0 var(--cor-dourado);
  }

  .inverno-form .botao {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .inverno-aviso {
    color: color-mix(in srgb, var(--cor-creme) 60%, transparent);
    font-size: 0.8125rem;
  }

  .inverno-confirmacao-titulo {
    margin-bottom: 0.75rem;
    font-family: var(--fonte-titulo);
    font-size: 2rem;
  }

  .inverno-nota {
    max-width: 30rem;
    color: color-mix(in srgb, var(--cor-creme) 78%, transparent);
  }

  @media (min-width: 768px) {
    .inverno {
      padding-block: 7rem;
    }

    .inverno-foto {
      aspect-ratio: 5 / 4;
    }

    .inverno-moldura::before {
      inset: 1rem -1rem -1rem 1rem;
    }
  }

  @media (min-width: 1024px) {
    .inverno-grade {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 5rem;
    }

    .inverno-moldura {
      order: 0;
    }

    .inverno-foto {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .inverno-ano {
      animation: brilho 8s ease-in-out infinite;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .inverno-foto {
        animation: revelar linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }

      .inverno-foto :global(img) {
        animation: aproximar linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 55%;
      }

      .inverno-letra {
        animation: subir linear both;
        animation-timeline: --titulo;
        animation-range: entry calc(var(--i) * 5%) entry calc(45% + var(--i) * 5%);
      }

      .inverno-ano {
        animation:
          subir linear both,
          brilho 8s ease-in-out infinite;
        animation-timeline: --titulo, auto;
        animation-range: entry 35% entry 90%, normal;
      }

      .inverno-titulo::after {
        animation: tracar linear both;
        animation-timeline: --titulo;
        animation-range: entry 50% entry 100%;
      }
    }
  }

  @keyframes revelar {
    from {
      clip-path: inset(14% 10% 14% 10% round 1.25rem);
    }
  }

  @keyframes aproximar {
    from {
      transform: scale(1.18);
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      filter: blur(0.25em);
      transform: translateY(0.45em);
    }
  }

  @keyframes tracar {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes brilho {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }
</style>
