---
const marcas = [
  'Nordevi',
  'Valmeira',
  'Aurelo',
  'Solenza',
  'Orvita',
  'Marlen & Co.',
  'Vinterno',
  'Hartvik',
];
---

<section class="marcas" id="marcas" aria-label="Marcas na loja">
  <p class="marcas-rotulo">Marcas na loja</p>

  <div class="faixa">
    <div class="trilho">
      {
        [0, 1].map((copia) => (
          <ul class="grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
            {marcas.map((marca) => (
              <li class="marca">{marca}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marcas {
    padding-block: 2.5rem;
    border-block: 1px solid var(--cor-linha);
    background: var(--cor-branco);
    overflow: hidden;
  }

  .marcas-rotulo {
    margin-bottom: 1.5rem;
    color: var(--cor-texto-suave);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-align: center;
    text-transform: uppercase;
  }

  .faixa {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
  }

  .trilho {
    display: flex;
    flex-shrink: 0;
    animation: correr 50s linear infinite;
  }

  .faixa:hover .trilho {
    animation-play-state: paused;
  }

  .grupo {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marca {
    padding-inline: clamp(1.75rem, 4vw, 3.5rem);
    color: var(--cor-marinho);
    font-family: var(--fonte-titulo);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1;
    white-space: nowrap;
  }

  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 768px) {
    .marcas {
      padding-block: 3.5rem;
    }

    .marcas-rotulo {
      margin-bottom: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faixa {
      justify-content: center;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .trilho {
      flex-shrink: 1;
      width: 100%;
      min-width: 0;
      animation: none;
    }

    .grupo {
      flex-shrink: 1;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      min-width: 0;
      row-gap: 1rem;
    }

    .grupo[aria-hidden='true'] {
      display: none;
    }
  }
</style>
